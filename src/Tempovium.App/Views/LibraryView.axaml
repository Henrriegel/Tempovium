<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tempovium.ViewModels"
             xmlns:entities="using:Tempovium.Core.Entities"
             xmlns:controls="using:Tempovium.Controls"
             xmlns:converters="using:Tempovium.Converters"
             x:Class="Tempovium.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

    <UserControl.Resources>
        <converters:MediaPathDisplayConverter x:Key="MediaPathDisplayConverter"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}"
          RowDefinitions="Auto,*"
          RowSpacing="16"
          Margin="18">

        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="16">
            <StackPanel Spacing="3">
                <TextBlock Text="Biblioteca"
                           Classes="h1"/>
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Top">
                <Button Content="⇧"
                        Classes="icon primary"
                        ToolTip.Tip="Importar archivo"
                        AutomationProperties.Name="Importar archivo"
                        IsEnabled="{Binding CanImport}"
                        Command="{Binding ImportFileCommand}"/>
                <Button Content="⊞"
                        Classes="icon"
                        ToolTip.Tip="Importar carpeta"
                        AutomationProperties.Name="Importar carpeta"
                        IsEnabled="{Binding CanImport}"
                        Command="{Binding ImportFolderCommand}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="360,*"
              ColumnSpacing="16">
            <Border Classes="panel"
                    Padding="14">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="12">
                    <TextBlock Text="Medios"
                               Classes="h2"/>

                    <ListBox Grid.Row="1"
                             Classes="clean"
                             ItemsSource="{Binding MediaItems}"
                             SelectedItem="{Binding SelectedMedia, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="entities:MediaItem">
                                <Border Classes="card selectable-card"
                                        Margin="0,0,0,10"
                                        Padding="13">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="10">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding MediaType}"
                                                       Classes="caption"/>
                                        </Grid>

                                        <TextBlock Text="{Binding FilePath, Converter={StaticResource MediaPathDisplayConverter}}"
                                                   Classes="caption"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Border Classes="panel"
                        Padding="22"
                        IsVisible="{Binding HasNoSelectedMedia}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <TextBlock Text="Selecciona un medio"
                                   Classes="h2"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="El reproductor y las notas aparecerán aquí."
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Grid IsVisible="{Binding HasSelectedMedia}"
                      RowDefinitions="*">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid RowDefinitions="Auto,Auto"
                              RowSpacing="14">
                            <controls:MediaPlayerView DataContext="{Binding MediaPlayerViewModel}"/>
                            <controls:NotesPanelView Grid.Row="1"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
