<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Tempovium.ViewModels"
             mc:Ignorable="d"
             x:Class="Tempovium.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14"
                    MaxWidth="520"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Border Classes="card"
                    Padding="28"
                    IsVisible="{Binding IsProfileListVisible}">
                <Grid RowDefinitions="Auto,Auto,*"
                      RowSpacing="16">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Tempovium"
                                       Classes="h1"/>
                            <TextBlock Text="Perfiles"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="+"
                                Classes="icon primary"
                                ToolTip.Tip="Crear perfil"
                                AutomationProperties.Name="Crear perfil"
                                Command="{Binding ShowCreateProfileCommand}"/>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="Selecciona un perfil local para continuar."
                               Classes="caption"/>

                    <ListBox Grid.Row="2"
                             Classes="clean"
                             ItemsSource="{Binding LocalUsers}"
                             SelectedItem="{Binding SelectedUserCard, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:UserCardViewModel">
                                <Border Classes="card selectable-card"
                                        Margin="0,0,0,10"
                                        Padding="14">
                                    <Grid ColumnDefinitions="Auto,*"
                                          ColumnSpacing="12">
                                        <Border Width="48"
                                                Height="48"
                                                CornerRadius="12"
                                                ClipToBounds="True"
                                                Background="{DynamicResource AppAccentSoftBrush}">
                                            <Grid>
                                                <Image Source="{Binding AvatarImage}"
                                                       Stretch="UniformToFill"
                                                       IsVisible="{Binding HasAvatar}"/>
                                                <TextBlock Text="{Binding Initials}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AppAccentBrush}"
                                                           IsVisible="{Binding HasNoAvatar}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Spacing="2"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Username}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding LastLoginText}"
                                                       Classes="caption"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Classes="card"
                    Padding="28"
                    IsVisible="{Binding IsCreateProfileVisible}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="10">
                        <Button Content="←"
                                Classes="icon"
                                ToolTip.Tip="Volver"
                                AutomationProperties.Name="Volver a perfiles"
                                IsVisible="{Binding CanGoBackToProfiles}"
                                Command="{Binding BackToProfilesCommand}"/>

                        <StackPanel Grid.Column="1"
                                    Spacing="4">
                            <TextBlock Text="Crear perfil"
                                       Classes="h1"/>
                            <TextBlock Text="Perfil local en este equipo."
                                       Classes="caption"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Nombre del perfil"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    <TextBox Text="{Binding Username}"
                             Watermark="Nombre visible"/>

                    <TextBlock Text="Avatar"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="12">
                        <Border Width="56"
                                Height="56"
                                CornerRadius="14"
                                ClipToBounds="True"
                                Background="{DynamicResource AppAccentSoftBrush}">
                            <Grid>
                                <Image Source="{Binding SelectedAvatarImage}"
                                       Stretch="UniformToFill"
                                       IsVisible="{Binding HasSelectedAvatar}"/>
                                <TextBlock Text="A"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppAccentBrush}"
                                           IsVisible="{Binding HasNoSelectedAvatar}"/>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedAvatarText}"
                                   VerticalAlignment="Center"
                                   Classes="caption"
                                   TextWrapping="Wrap"/>

                        <Button Grid.Column="2"
                                Content="◉"
                                Classes="icon"
                                ToolTip.Tip="Elegir avatar"
                                AutomationProperties.Name="Elegir avatar"
                                Command="{Binding PickAvatarCommand}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <TextBlock Text="{Binding StatusMessage}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        <Button Grid.Column="1"
                                Content="→"
                                Classes="icon primary"
                                ToolTip.Tip="Crear perfil"
                                AutomationProperties.Name="Crear perfil"
                                Command="{Binding CreateProfileCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
