<UserControl
    x:Class="Tempovium.Controls.MediaPlayerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Tempovium.ViewModels"
    x:DataType="vm:MediaPlayerViewModel">

    <Border Classes="panel"
            Padding="18">
        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="14">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="14">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding CurrentMediaTitle}"
                               Classes="h2"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding CurrentMediaPath}"
                               Classes="caption"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{DynamicResource AppCardMutedBrush}"
                        CornerRadius="8"
                        Padding="10,6"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding CurrentMediaType}"
                               Classes="caption"/>
                </Border>
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="{Binding BackendStatus}"
                       Classes="caption"/>

            <Grid Grid.Row="2">
                <Border Height="300"
                        Classes="card"
                        Background="{DynamicResource AppCardMutedBrush}"
                        IsVisible="{Binding HasNoSelectedMedia}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="Selecciona un medio para comenzar."
                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </Border>

                <Border Height="360"
                        Classes="card"
                        Padding="0"
                        IsVisible="{Binding ShowNativeVideoHost}">
                    <Grid>
                        <ContentControl x:Name="NativeVideoHostContainer" />

                        <Border Background="{DynamicResource AppOverlayBrush}"
                                IsVisible="{Binding IsLoading}">
                            <StackPanel Width="260"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10">
                                <ProgressBar IsIndeterminate="True"
                                             Height="6"/>
                                <TextBlock Text="{Binding PlayerStatusText}"
                                           HorizontalAlignment="Center"
                                           Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Height="300"
                        Classes="card"
                        Background="{DynamicResource AppCardMutedBrush}"
                        IsVisible="{Binding ShowUnsupportedPlaybackPlaceholder}">
                    <StackPanel Spacing="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="Reproducción no disponible"
                                   Classes="h2"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding UnsupportedPlaybackMessage}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Classes="card"
                        Background="{DynamicResource AppCardMutedBrush}"
                        IsVisible="{Binding ShowAudioTransportControls}">
                    <Grid RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="18">
                        <StackPanel Spacing="8"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="Audio"
                                       Classes="h2"
                                       HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="7"
                                        HorizontalAlignment="Center">
                                <Border Width="10" Height="34" Background="{DynamicResource AppAccentBrush}" CornerRadius="6"/>
                                <Border Width="10" Height="62" Background="{DynamicResource AppAccentBrush}" CornerRadius="6"/>
                                <Border Width="10" Height="44" Background="{DynamicResource AppAccentBrush}" CornerRadius="6"/>
                                <Border Width="10" Height="76" Background="{DynamicResource AppAccentBrush}" CornerRadius="6"/>
                                <Border Width="10" Height="50" Background="{DynamicResource AppAccentBrush}" CornerRadius="6"/>
                                <Border Width="10" Height="68" Background="{DynamicResource AppAccentBrush}" CornerRadius="6"/>
                                <Border Width="10" Height="38" Background="{DynamicResource AppAccentBrush}" CornerRadius="6"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PlayerStatusText}"
                                       Classes="caption"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="10">
                            <Button Width="100"
                                    Content="▶"
                                    Classes="icon primary"
                                    ToolTip.Tip="Reproducir"
                                    AutomationProperties.Name="Reproducir"
                                    Command="{Binding PlayCommand}"
                                    IsVisible="{Binding IsPaused}"/>
                            <Button Width="100"
                                    Content="Ⅱ"
                                    Classes="icon"
                                    ToolTip.Tip="Pausar"
                                    AutomationProperties.Name="Pausar"
                                    Command="{Binding PauseCommand}"
                                    IsVisible="{Binding IsPlaying}"/>
                        </StackPanel>

                        <Grid Grid.Row="2"
                              ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="12"
                              VerticalAlignment="Center">
                            <TextBlock Text="{Binding PositionSeconds, StringFormat='{}{0:F1}s'}"
                                       Classes="caption"
                                       MinWidth="56"
                                       VerticalAlignment="Center"/>

                            <Slider x:Name="TimelineSlider"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="{Binding DurationSeconds, Mode=OneWay}"
                                    Value="{Binding PositionSeconds, Mode=OneWay}"
                                    PointerReleased="OnTimelineSliderPointerReleased"
                                    VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding DurationSeconds, StringFormat='{}{0:F1}s'}"
                                       Classes="caption"
                                       MinWidth="56"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
